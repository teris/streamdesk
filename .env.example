# Example only. install.sh generates the active root-private /etc/streamdesk.env.
STREAMDESK_PUBLIC="https://stream.example.com"
STREAMDESK_INGEST="ingest.example.com"
STREAMDESK_BIND="0.0.0.0:8080"
STREAMDESK_DATA="/var/lib/streamdesk"
STREAMDESK_DEFAULT_CLIP="/var/lib/streamdesk/standby.mp4"
STREAMDESK_NAMESPACE="streamdesk"
MEDIAMTX_CONFIG="/opt/mediamtx/mediamtx.yml"
MEDIAMTX_API="http://127.0.0.1:9997/v3/"
MEDIAMTX_HLS="http://127.0.0.1:8888/"
MEDIAMTX_RTSP="rtsp://127.0.0.1:8554/"
MEDIAMTX_RTMP_PORT="1935"
MEDIAMTX_SRT_PORT="8890"
STREAMDESK_BROWSER_ROOT="/var/lib/streamdesk-browser"
STREAMDESK_BROWSER_USER="streamdesk-browser"
STREAMDESK_BROWSER_LIMIT="auto"
STREAMDESK_BROWSER_FPS="10"
STREAMDESK_LOCAL_IPS="127.0.0.1,::1"
STREAMDESK_TRUST_PROXY="1"
COOKIE_SECURE="1"
