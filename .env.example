# Example only. install.sh generates the active root-private /etc/streamdesk.env.
STREAMDESK_PUBLIC="https://stream.example.com"
STREAMDESK_INGEST="ingest.example.com"
STREAMDESK_BIND="0.0.0.0:8080"
STREAMDESK_DATA="/var/lib/streamdesk"
STREAMDESK_APP_DIR="/opt/streamdesk"
STREAMDESK_NATIVE_ROOT="/var/lib/streamdesk-native"
STREAMDESK_DEFAULT_CLIP="/var/lib/streamdesk/standby.mp4"
STREAMDESK_NAMESPACE="streamdesk"
MEDIAMTX_CONFIG="/opt/mediamtx/mediamtx.yml"
MEDIAMTX_API="http://127.0.0.1:9997/v3/"
# Optional CA for the HTTPS Control API; certificate checks remain enabled.
# MEDIAMTX_API_CA="/var/lib/streamdesk/mediamtx-api-ca.pem"
MEDIAMTX_METRICS="http://127.0.0.1:9998/metrics"
MEDIAMTX_HLS="http://127.0.0.1:8888/"
# Optional override; otherwise derived from the local MediaMTX WebRTC listener.
# MEDIAMTX_WEBRTC="http://127.0.0.1:8889/"
# Optional override; otherwise derived from playbackAddress/playbackEncryption.
# MEDIAMTX_PLAYBACK="http://127.0.0.1:9996/"
MEDIAMTX_RTSP="rtsp://127.0.0.1:8554/"
MEDIAMTX_RTMP_PORT="1935"
MEDIAMTX_SRT_PORT="8890"
MEDIAMTX_MOQ_PORT="8892"
# Remote mode needs explicit endpoints and exact UI source IPs; see INSTALL.md.
STREAMDESK_MEDIAMTX_MODE="local-attach"
STREAMDESK_NATIVE_SHARED="0"
STREAMDESK_HOOK_ALLOWLIST="{}"
STREAMDESK_BROWSER_ROOT="/var/lib/streamdesk-browser"
STREAMDESK_BROWSER_USER="streamdesk-browser"
STREAMDESK_BROWSER_LIMIT="auto"
STREAMDESK_BROWSER_FPS="10"
STREAMDESK_LOCAL_IPS="127.0.0.1,::1"
STREAMDESK_TRUST_PROXY="1"
COOKIE_SECURE="1"

# Native installer configures an isolated explicit-FTPS service. Disabled for manual/container setups.
STREAMDESK_FTP_ENABLED="0"
STREAMDESK_FTP_PORT="2121"
STREAMDESK_FTP_PASSIVE="30000:30049"
STREAMDESK_FTP_LOG="/var/log/streamdesk-ftp/transfers.log"
